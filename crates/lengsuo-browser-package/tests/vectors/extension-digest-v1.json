{
  "schema": "lengsuo-extension-digest-vectors",
  "schema_version": 1,
  "algorithm": "sha256-tree-v1",
  "algorithm_spec": "for each file sorted by UTF-8 byte order of relative POSIX path: sha256_update(path_utf8) || 0x00 || sha256(content)[raw 32 bytes] || 0x00 ; final = sha256(stream)",
  "rules": [
    "only regular files (symlinks skipped entirely, never followed)",
    "relative POSIX path, '/' separator, never backslash",
    "sort by UTF-8 byte order (NOT locale, NOT UTF-16 code unit order)",
    "empty directories contribute nothing",
    "per-file digest is the raw 32 bytes, never hex",
    "path and content digest joined by a single 0x00 byte each"
  ],
