{
  "note": "W3a-2 载荷层固定向量。期望值全部手写（base64url/JSON 转义另经 python 标准库独立核对，⛔ 非本仓实现的回灌）。改任何期望字节前先对契约 §5.3.1。",
  "limits": {"max_json_bytes": 1048576, "max_json_depth": 16},
  "cross_end": [
    {"field": "nonce", "wire": "nonce", "js": "fido2_page_script.js:88 / :102", "js_expr": "nonce: newNonce()", "rust": "decode_request -> fields.uint(\"nonce\")", "match": true},
    {"field": "origin", "wire": "origin", "js": "fido2_page_script.js:89 / :103", "js_expr": "origin: location.origin", "rust": "origin_field（fail-closed 形状校验）", "match": true},
    {"field": "rp_id", "wire": "rp_id", "js": "fido2_page_script.js:90 / :104", "js_expr": "rp_id: options.rp.id | options.rpId", "rust": "fields.string(\"rp_id\")", "match": true},
    {"field": "challenge", "wire": "challenge", "js": "fido2_page_script.js:91 / :105", "js_expr": "challenge: b64urlEncode(options.challenge)", "rust": "binary_field(\"challenge\")（base64url 校验）", "match": true},
    {"field": "user.id", "wire": "user.id", "js": "fido2_page_script.js:93", "js_expr": "id: b64urlEncode(options.user.id)", "rust": "binary_field(&user, \"id\")", "match": true},
    {"field": "user.name", "wire": "user.name", "js": "fido2_page_script.js:94", "js_expr": "name: options.user.name", "rust": "user.string(\"name\")", "match": true},
    {"field": "user.display_name", "wire": "user.display_name", "js": "fido2_page_script.js:95", "js_expr": "display_name: options.user.displayName", "rust": "user.string(\"display_name\")", "match": true},
    {"field": "allow_ids", "wire": "allow_ids", "js": "fido2_page_script.js:106", "js_expr": "allow_ids: options.allowCredentials.map(c => b64urlEncode(c.id))", "rust": "binary_strings(\"allow_ids\")", "match": true},
    {"field": "nonce 生成范围", "wire": "u32 -> u64", "js": "fido2_page_script.js:80-82", "js_expr": "crypto.getRandomValues(new Uint32Array(1))[0]", "rust": "收 u64（宽容且前向兼容）", "match": true},
    {"field": "载荷字节透传", "wire": "(bytes)", "js": "service_worker.js:93-94", "js_expr": "new TextEncoder().encode(JSON.stringify(payload))", "rust": "decode_request(type, bytes)", "match": true},
    {"field": "type 10 回退", "wire": "USE_NATIVE_RESPONSE", "js": "service_worker.js:95-97", "js_expr": "reply.type === MSG.USE_NATIVE_RESPONSE", "rust": "Request::UseNativeResponse（载荷 {}）", "match": true}
  ],
